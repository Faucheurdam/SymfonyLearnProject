{% extends 'base.html.twig' %}

{% block title %}Liste des tâches{% endblock %}

{% block body %}
    <h1>Liste des tâches</h1>

    {% if tasks is empty %}
        <p>Aucune tâche pour le moment.</p>
    {% else %}
        <ul class="task-list">
            {% for task in tasks %}
                <li class="task-item">
                    <strong>{{ task.title }}</strong>

                    {% if task.description %}
                        <p>{{ task.description }}</p>
                    {% endif %}

                    <div class="task-meta">
                        Statut :
                        {% if task.isDone %}
                            <span class="status-done">Terminée</span>
                        {% else %}
                            <span class="status-pending">En cours</span>
                        {% endif %}
                        <br>
                        Créée le : {{ task.createdAt|date('d/m/Y H:i') }}
                    </div>

                    <div class="task-actions">
                        <a href="{{ path('app_task_show', {id: task.id}) }}">Voir</a>
                        <a href="{{ path('app_task_edit', {id: task.id}) }}">Modifier</a>

                        <form method="post" action="{{ path('app_task_toggle', {id: task.id}) }}" class="inline-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_task_' ~ task.id) }}">
                            <button type="submit" class="link-button">
                                {% if task.isDone %}
                                    Marquer comme en cours
                                {% else %}
                                    Marquer comme terminée
                                {% endif %}
                            </button>
                        </form>

                        <form method="post" action="{{ path('app_task_delete', {id: task.id}) }}" class="inline-form" onsubmit="return confirm('Supprimer cette tâche ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_task_' ~ task.id) }}">
                            <button type="submit">Supprimer</button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
